{
  "expo": {
    "name": "TableDash for Restaurants",
    "slug": "tabledash-restaurant",
    "scheme": "tabledash-restaurant",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tabledash.restaurant",
      "supportsTablet": true
    },
    "android": {
      "package": "com.tabledash.restaurant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF5A3C"
      }
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14213D"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "TableDash for Restaurants",
      "shortName": "TableDash",
      "themeColor": "#14213D",
      "backgroundColor": "#14213D"
    },
    "primaryColor": "#FF5A3C"
  }
}
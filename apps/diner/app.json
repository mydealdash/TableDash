{
  "expo": {
    "name": "TableDash",
    "slug": "tabledash",
    "scheme": "tabledash",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": { "bundleIdentifier": "com.tabledash.app", "supportsTablet": false,
      "infoPlist": { "NSLocationWhenInUseUsageDescription": "Find restaurants near you." } },
    "android": { "package": "com.tabledash.app", "permissions": ["ACCESS_COARSE_LOCATION"] },
    "plugins": ["expo-secure-store", "expo-location", "expo-notifications"],
    "extra": { "apiUrl": "http://localhost:4000" }
  }
}
